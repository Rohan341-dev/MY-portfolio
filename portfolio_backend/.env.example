# Copy this file to portfolio_backend/.env and fill in your values.
# .env is gitignored — never commit real credentials.

# Gmail SMTP (port 587 + TLS)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true

# Your full Gmail address
EMAIL_HOST_USER=you@gmail.com

# 16-character Gmail App Password (NOT your Google account password).
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled)
EMAIL_HOST_PASSWORD=

# Gmail requires the From address to match EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=you@gmail.com

# Where contact form messages are delivered (defaults to DEFAULT_FROM_EMAIL)
CONTACT_TO_EMAIL=you@gmail.com
